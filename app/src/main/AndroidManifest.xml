<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <!-- RECORD_AUDIO would otherwise imply one; voice messages are optional. -->
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Recording voice messages; asked for the first time the user records one. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Sharing your location in a message, once, when asked; asked for on first use. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Our own number, to leave ourselves out of group MMS participant lists. -->
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <!-- Lists the SIMs on dual-SIM phones, to choose which one a text goes out on. Requested only there. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- App lock (Settings → Security): fingerprint, face or screen lock. Granted at install. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Scheduled send: exact alarms if the user allows them, re-armed after a reboot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      No platform backup or device transfer: API keys are sealed to this phone's Keystore.
      Settings → Backup moves messages and decisions to a new phone instead.
    -->
    <application
        android:name=".WinnowApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Winnow">

        <!-- Messages in Android Auto: notifications only (MessagingStyle, Reply, Mark as read). -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- The app lock, stacked on top of whatever is open. -->
        <activity
            android:name=".ui.lock.LockActivity"
            android:exported="false"
            android:launchMode="singleTop" />
        <!-- A conversation in a chat bubble. Bubbles need an embeddable, resizable activity. -->
        <activity
            android:name=".ui.BubbleActivity"
            android:allowEmbedded="true"
            android:documentLaunchMode="always"
            android:exported="false"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- MainActivity's SENDTO filter, the SMS and WAP push receivers, and the respond-via-message
             service are the four things Android requires of a default SMS app. -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <!-- Share text, photos, videos and contacts from other apps: pick who to send them to. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
                <data android:mimeType="text/x-vcard" />
                <data android:mimeType="text/vcard" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sms.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Weekly automatic backups (Settings → Backup), run by JobScheduler while charging. -->
        <service
            android:name=".backup.AutoBackupJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".sms.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <receiver
            android:name=".sms.SmsStatusReceiver"
            android:exported="false" />

        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".sms.MmsSentReceiver"
            android:exported="false" />

        <receiver
            android:name=".sms.MmsDownloadedReceiver"
            android:exported="false" />

        <!-- Shares PDU files with the system MMS service for sending and downloading. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mms"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/mms_paths" />
        </provider>

        <!-- The daily summary's evening alarm (Settings → Daily summary). -->
        <receiver
            android:name=".notify.DailySummaryReceiver"
            android:exported="false" />

        <receiver
            android:name=".sms.ScheduledSendReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
