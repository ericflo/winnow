<?xml version="1.0" encoding="utf-8"?>
<!-- What the Conversations widget looks like, for the launcher's widget picker (sample people). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Winnow"
        android:textColor="@android:color/system_neutral1_900"
        android:textSize="18sp" />

    <TextView style="@style/WidgetPreviewName" android:text="Casey Lin" android:textStyle="bold" />
    <TextView style="@style/WidgetPreviewLine" android:text="See you at 7!" android:textStyle="bold" />
    <TextView style="@style/WidgetPreviewName" android:text="Lake house crew" />
    <TextView style="@style/WidgetPreviewLine" android:text="Count me in" />
    <TextView style="@style/WidgetPreviewName" android:text="Morgan Reyes" />
    <TextView style="@style/WidgetPreviewLine" android:text="On my way" />
</LinearLayout>
