<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing goes to cloud backup or device-to-device transfer. API keys are sealed with a
  Keystore key that can't leave this phone, and Winnow's own file backup (Settings → Backup)
  carries messages and decisions to a new phone explicitly.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
