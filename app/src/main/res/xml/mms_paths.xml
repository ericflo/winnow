<?xml version="1.0" encoding="utf-8"?>
<!-- PDUs handed to the system MMS service live here, briefly. -->
<paths>
    <cache-path name="mms" path="mms/" />
    <!-- Photos taken from the composer's Camera option, until they're sent. -->
    <cache-path name="camera" path="camera/" />
    <!-- Copies of attachments handed to another app from Share, briefly. -->
    <cache-path name="outbox" path="outbox/" />
    <!-- Small copies of received photos, shown in their notification. -->
    <cache-path name="notified" path="notified/" />
</paths>
