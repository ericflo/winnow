<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A stand-in classifier server on the development machine may speak plain HTTP (see the config). -->
    <application android:networkSecurityConfig="@xml/network_security_config">
        <!--
          Debug builds only: lets adb feed MMS through the real receive path, since emulators
          have no MMSC. DUMP is held by the adb shell but no ordinary app, so only adb can send.
        -->
        <receiver
            android:name=".debug.DebugMmsReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".debug.DebugRepliesReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".debug.DebugSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".debug.DebugCodesReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".debug.DebugSimReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <receiver
            android:name=".debug.DebugTrafficReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
